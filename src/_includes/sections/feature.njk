{# section.type: feature — text + media
   Shell: .section-{type}.wrapper[data-section-theme] > .full.wrapper.section
   width content|feature: both inside that measure
   width full: copy stays in feature band; media breaks out (side edge or full-bleed below)
   media_side: left | right | bottom
   appearance.lightbox: open image in dialog on click (same pattern as gallery)
   Do not wrap {% image %} / {% svg %} in macros — they cannot await. #}
{% css "local" %}
  {% include "css/sections/feature.css" %}
{% endcss %}

{% from "sections/_shell.njk" import sectionThemeAttr, sectionAccentAttr, sectionButtonAttr, sectionWidthClass %}

{% set s = section %}
{% set a = s.appearance or {} %}
{% set theme = a.theme or s.theme or "background-default" %}
{% set accent = a.accent if a.accent is defined else s.accent %}
{% set width = a.width if a.width is defined else s.width %}
{% if not width %}
  {% set width = "feature" %}
{% endif %}
{% set mediaSide = a.media_side or s.media_side or "right" %}
{% set widthClass = sectionWidthClass(width) %}
{% set lightbox = a.lightbox if a.lightbox is defined else s.lightbox %}

{% if lightbox and s.image %}
  {% js "defer" %}
    {% include "scripts/feature-lightbox.js" %}
  {% endjs %}
{% endif %}

<div class="section-feature | wrapper" {{ sectionThemeAttr(theme) }}{{ sectionAccentAttr(accent) }} data-feature-width="{{ width }}" data-media-side="{{ mediaSide }}"{% if lightbox %} data-feature-lightbox="true"{% endif %}{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="full wrapper section">
    {% if width == "full" %}
      <div class="section-feature__copy | flow prose region">
        {% if s.title %}<h2>{{ s.title | markdownInline | safe }}</h2>{% endif %}
        {% if s.content %}{{ s.content | markdownFormat | safe }}{% endif %}
        {% if s.button_text and s.button_target %}
          <a href="{{ s.button_target }}" class="button" {{ sectionButtonAttr(accent) }}>
            {{ s.button_text }} {% svg "misc/arrow" %}
          </a>
        {% endif %}
      </div>
      {% if s.image %}
        <div class="section-feature__media">
          {% if lightbox %}
            <is-land on:idle>
              <div class="gallery">
                <dialog class="flow">
                  <button type="button" class="button" autofocus>Close</button>
                  {% image s.image, s.image_alt or "", s.caption or "" %}
                </dialog>
                <button type="button" data-lightbox-trigger>
                  {% image s.image, s.image_alt or "", "" %}
                </button>
              </div>
            </is-land>
            {% if s.caption %}
              <p class="section-feature__caption">{{ s.caption }}</p>
            {% endif %}
          {% else %}
            {% image s.image, s.image_alt or "", s.caption or "" %}
          {% endif %}
        </div>
      {% endif %}
    {% else %}
      <div class="{% if widthClass %}{{ widthClass }} | {% endif %}section__inner region">
        <div class="section-feature__grid">
          <div class="section-feature__copy | flow prose">
            {% if s.title %}<h2>{{ s.title | markdownInline | safe }}</h2>{% endif %}
            {% if s.content %}{{ s.content | markdownFormat | safe }}{% endif %}
            {% if s.button_text and s.button_target %}
              <a href="{{ s.button_target }}" class="button" {{ sectionButtonAttr(accent) }}>
                {{ s.button_text }} {% svg "misc/arrow" %}
              </a>
            {% endif %}
          </div>
          {% if s.image %}
            <div class="section-feature__media">
              {% if lightbox %}
                <is-land on:idle>
                  <div class="gallery">
                    <dialog class="flow">
                      <button type="button" class="button" autofocus>Close</button>
                      {% image s.image, s.image_alt or "", s.caption or "" %}
                    </dialog>
                    <button type="button" data-lightbox-trigger>
                      {% image s.image, s.image_alt or "", "" %}
                    </button>
                  </div>
                </is-land>
                {% if s.caption %}
                  <p class="section-feature__caption">{{ s.caption }}</p>
                {% endif %}
              {% else %}
                {% image s.image, s.image_alt or "", s.caption or "" %}
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>
