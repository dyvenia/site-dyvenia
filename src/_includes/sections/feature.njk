{# section.type: feature — expects `section` in scope
   Shell: .section-{type}.wrapper[data-section-theme] > .full.wrapper.section > .section__inner #}
{% from "sections/_shell.njk" import sectionWidthClass, sectionAlignClass, sectionThemeAttr, sectionAccentAttr, sectionButtonAttr %}

{% set s = section %}
{% set a = s.appearance or {} %}
{% set theme = a.theme or s.theme or "white" %}
{% set accent = a.accent if a.accent is defined else s.accent %}
{% set align = a.align if a.align is defined else s.align %}
{% set width = a.width if a.width is defined else s.width %}
{% set widthClass = sectionWidthClass(width or "feature") or "feature" %}
{% set alignClass = sectionAlignClass(align) %}
{% set mediaSide = a.media_side or s.media_side or "right" %}

<div class="section-feature | wrapper" {{ sectionThemeAttr(theme) }}{{ sectionAccentAttr(accent) }}{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="full wrapper section">
    <div class="{{ widthClass }} | section__inner region">
      <div class="grid {{ alignClass }}" data-layout="50-50"{% if mediaSide == "left" %} style="direction: rtl"{% endif %}>
        <div class="flow prose" style="direction: ltr">
          {% if s.title %}<h2>{{ s.title | markdownInline | safe }}</h2>{% endif %}
          {% if s.content %}{{ s.content | markdownFormat | safe }}{% endif %}
          {% if s.button_text and s.button_target %}
            <a
              href="{{ s.button_target }}"
              class="button"
              {{ sectionButtonAttr(accent) }}
            >
              {{ s.button_text }} {% svg "misc/arrow" %}
            </a>
          {% endif %}
        </div>
        {% if s.image %}
          <div style="direction: ltr">
            {% image s.image, s.image_alt or "", "feature" %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
