{# section.type: text — expects `section` in scope
   Shell: .section-{type}.wrapper[data-section-theme] > .full.wrapper.section > .section__inner #}
{% from "sections/_shell.njk" import sectionWidthClass, sectionAlignClass, sectionThemeAttr, sectionAccentAttr %}

{% set s = section %}
{% set a = s.appearance or {} %}
{% set theme = a.theme or s.theme or "white" %}
{% set accent = a.accent if a.accent is defined else s.accent %}
{% set align = a.align if a.align is defined else s.align %}
{% set width = a.width if a.width is defined else s.width %}
{% set widthClass = sectionWidthClass(width or "feature") or "feature" %}
{% set alignClass = sectionAlignClass(align) %}
{% set isSplit = s.content_left or s.content_right %}

<div class="section-text | wrapper" {{ sectionThemeAttr(theme) }}{{ sectionAccentAttr(accent) }}{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="full wrapper section">
    <article class="{{ widthClass }} | section__inner region flow prose {{ alignClass }}">
      {% if s.title %}<h2>{{ s.title | markdownInline | safe }}</h2>{% endif %}
      {% if isSplit %}
        <div class="grid" data-layout="50-50">
          <div>{{ s.content_left | markdownFormat | safe }}</div>
          <div>{{ s.content_right | markdownFormat | safe }}</div>
        </div>
      {% elif s.content %}
        {{ s.content | markdownFormat | safe }}
      {% endif %}
    </article>
  </div>
</div>
