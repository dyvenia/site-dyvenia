{# section.type: services — expects `section` in scope
   Full-bleed BG image + stacked service rows #}
{% css "local" %}
  {% include "css/sections/services.css" %}
{% endcss %}

{% from "sections/_shell.njk" import sectionThemeAttr, sectionAccentAttr %}

{% set s = section %}
{% set a = s.appearance or {} %}
{% set theme = a.theme or s.theme or "navy" %}
{% set accent = a.accent if a.accent is defined else s.accent %}
{% set align = a.align if a.align is defined else s.align %}

<div class="section-services | wrapper" {{ sectionThemeAttr(theme) }}{{ sectionAccentAttr(accent) }}{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="section-services__band | full wrapper section">
    {% if s.image %}
      {% image s.image, "" %}
    {% endif %}
    <article class="wrapper region flow">
      {% if s.title %}<h2 class="text-center">{{ s.title | markdownInline | safe }}</h2>{% endif %}
      {% for item in s.items %}
        <div class="grid" data-layout="thirds">
          <h3>
            {% if item.prefix %}<span>{{ item.prefix }}</span>{% endif %}
            {{ item.title }}
          </h3>
          <div>
            {{ (item.description or item.content) | markdownFormat | safe }}
          </div>
        </div>
      {% endfor %}
    </article>
  </div>
</div>
