<form class="sg-preview sg-preview--theme | cluster" aria-label="Section theme fixtures">
  <div class="sg-preview__field | cluster">
    <label for="sg-theme">Theme</label>
    <select id="sg-theme" data-sg-theme name="theme">
      {% for theme in styleguide.sectionAppearance.themes %}
        <option value="{{ theme }}">{{ theme }}</option>
      {% endfor %}
    </select>
  </div>
  <div class="sg-preview__field | cluster">
    <label for="sg-accent">Accent</label>
    <select id="sg-accent" data-sg-accent name="accent">
      {% for accent in styleguide.sectionAppearance.accents %}
        <option value="{{ accent }}">
          {% if accent == "default" %}default (theme){% else %}{{ accent }}{% endif %}
        </option>
      {% endfor %}
    </select>
  </div>
</form>
