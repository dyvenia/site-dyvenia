<div
  id="consent-banner"
  class="consent flow"
  data-section-theme="gray-dark"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="consent-title"
  aria-describedby="consent-description"
>
  <h2 id="consent-title" class="visually-hidden">Cookie Consent</h2>
  <p id="consent-description">{{ consent.message | safe }}</p>

  <div class="consent-services | flow">
    <div class="service-item | repel gutter-2xs">
      <div class="flow flow-space-xs">
        <h3 class="text-step-min-1">{{ consent.marketing_title }}</h3>
        <p class="text-step-min-1 text-gray">{{ consent.marketing_description | safe }}</p>
      </div>
      <div class="cluster gutter-3xs">
        <button
          type="button"
          class="button"
          data-service-decline="marketing"
          data-small-button
          data-ghost-button
          aria-pressed="false"
        >
          <span>{{ consent.decline }}</span>
        </button>
        <button
          type="button"
          class="button"
          data-service-accept="marketing"
          data-ghost-button
          data-small-button
          aria-pressed="false"
        >
          <span>{{ consent.accept }}</span>
        </button>
      </div>
    </div>
  </div>

  <div class="cluster gutter-2xs mt-m" data-consent-all-actions hidden>
    <button
      type="button"
      class="button"
      data-consent-decline
      data-small-button
      data-ghost-button
      data-button-variant="neutral"
    >
      <span>{{ consent.decline_all }}</span>
    </button>
    <button type="button" class="button" data-consent-accept data-small-button data-button-variant="neutral">
      <span>{{ consent.accept_all }}</span>
    </button>
  </div>
</div>
