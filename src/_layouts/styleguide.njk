---
layout: base
---

{# Styleguide with top nav — sections can render full viewport width #}
<div class="styleguide-full">
  <div
    class="styleguide-full__nav | wrapper region"
    style="--region-space-top: var(--space-2xl); --region-space-bottom: 0;"
  >
    <div class="styleguide-full__nav-inner | cluster">{% include "partials/styleguide-nav.njk" %}</div>
  </div>

  {{ content | safe }}
</div>

{%- css "local" -%}
  {%- include 'css/styleguide.css' -%}
{%- endcss -%}
